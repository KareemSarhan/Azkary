# Azkary direct APK releases.
#
# The Caddy container mounts /root/services/caddy/data/site on the host as /srv.
# Host release directory:
#   /root/services/caddy/data/site/azkary/releases

handle /azkary/releases/update.json {
    root * /srv
    file_server
    header Cache-Control "no-store, no-cache, must-revalidate"
    header Pragma "no-cache"
    header X-Content-Type-Options "nosniff"
}

handle /azkary/releases/Azkary-latest-selfHosted-release.apk* {
    root * /srv
    file_server
    header Cache-Control "no-store, no-cache, must-revalidate"
    header Pragma "no-cache"
    header X-Content-Type-Options "nosniff"
}

handle_path /azkary/releases/* {
    root * /srv/azkary/releases
    file_server
    header Cache-Control "public, max-age=31536000, immutable"
    header X-Content-Type-Options "nosniff"
}
